<%- include('partials/header') %>

<section class="container page-section">
  <div class="panel">
    <h1 class="page-title">Blogs</h1>
    <% if (posts.length) { %>
      <div class="blog-grid">
        <% posts.forEach(function (post) { %>
          <a class="blog-card" href="<%= base %>/blogs/<%= post.slug %>/">
            <% if (post.image) { %>
              <img class="blog-card__image" src="<%= base + post.image.cardUrl %>" alt="" loading="lazy" />
            <% } %>
            <span class="blog-card__body">
              <span class="blog-card__date"><%= post.date %></span>
              <span class="blog-card__title"><%= post.title %></span>
              <span class="blog-card__text"><%= post.description %></span>
            </span>
          </a>
        <% }) %>
      </div>
    <% } else { %>
      <p class="muted">Check back for guides to everyday calculations, unit conversions, and generators.</p>
      <section class="content-section">
        <h2 class="tool-heading">Use a tool now</h2>
        <p>Browse <a href="<%= base %>/tools/">All Tools</a> to find a calculator, converter, or generator. For help getting started, see <a href="<%= base %>/how-to-use/">How to Use Calculators</a>.</p>
      </section>
    <% } %>
  </div>
</section>

<%- include('partials/footer') %>
