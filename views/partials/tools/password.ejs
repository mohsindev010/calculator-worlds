<div class="tool-page-calc">
  <form class="calc tool-calc" id="passwordTool" autocomplete="off" novalidate>
    <div class="calc__display">
      <div class="calc__expr" id="passwordLabel"></div>
      <div class="calc__result password-output" id="passwordResult"></div>
    </div>
    <div class="tool-calc__body">
      <label class="field password-length">
        <span class="field__label">Length (4 to 128)</span>
        <input class="field__input" type="number" min="4" max="128" step="1" inputmode="numeric" name="chars" value="16" />
      </label>

      <div class="check-grid">
        <label class="check"><input type="checkbox" name="upper" checked /><span>Uppercase (A&ndash;Z)</span></label>
        <label class="check"><input type="checkbox" name="lower" checked /><span>Lowercase (a&ndash;z)</span></label>
        <label class="check"><input type="checkbox" name="digits" checked /><span>Numbers (0&ndash;9)</span></label>
        <label class="check"><input type="checkbox" name="symbols" checked /><span>Symbols (!@#$&hellip;)</span></label>
        <label class="check"><input type="checkbox" name="noAmbiguous" /><span>Avoid look-alikes (O, 0, I, l, 1)</span></label>
      </div>

      <div class="tool-actions">
        <button type="submit" class="key key--e">Generate</button>
        <button type="button" class="key" id="passwordCopy">Copy</button>
      </div>

      <p class="tool-note">Your password is created in your browser using its secure random source. It isn't sent anywhere or saved.</p>
    </div>
  </form>
</div>
