<%- include('partials/header') %>

<%# Search runs in the browser (static hosting has no server): every tool card is rendered
    hidden, and main.js reveals the ones matching ?q=... %>
<section class="container page-section">
  <div class="panel" id="searchPage">
    <h1 class="page-title">Search Results</h1>
    <p class="muted" id="searchIntro">Search by tool name, category, or task.</p>
    <p class="muted" id="searchSummary">Enter a term such as percentage, loan, BMI, or age.</p>

    <div class="tool-grid" id="searchGrid">
      <% allTools.forEach(function (tool) { %>
        <%- include('partials/tool-card', { tool: tool }) %>
      <% }) %>
    </div>
    <p class="no-results" id="searchEmpty" hidden><span id="searchEmptyText"></span> Try a shorter term or browse <a href="<%= base %>/tools/">All Tools</a>.</p>
  </div>
</section>

<%- include('partials/footer') %>
