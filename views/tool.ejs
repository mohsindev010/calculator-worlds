<%
  // Tools with their own interface: slug -> partials/tools/<name>.ejs + /js/<name>.js
  const widgets = {
    'percentage-calculator': 'percentage',
    'age-calculator': 'age',
    'loan-calculator': 'loan',
    'mortgage-calculator': 'mortgage',
    'bmi-calculator': 'bmi',
    'time-converter': 'converter',
    'temperature-converter': 'converter',
    'length-converter': 'converter',
    'weight-converter': 'converter',
    'currency-converter': 'currency',
    'qr-code-generator': 'qr',
    'random-number-generator': 'random',
    'password-generator': 'password',
  };
  const widget = widgets[tool.slug];
%>
<%- include('partials/header') %>

<section class="container page-section">
  <div class="panel">
    <p class="crumbs"><a href="<%= base %>/">Home</a> / <a href="<%= base %>/tools/">Tools</a> / <%= tool.name %></p>
    <h1 class="page-title"><%= tool.name %></h1>

    <% if (tool.slug === 'standard-calculator') { %>
      <div class="tool-page-calc">
        <%- include('partials/calculator') %>
      </div>
    <% } else if (widget) { %>
      <%- include('partials/tools/' + widget) %>
    <% } else { %>
      <p class="muted">This tool page is ready to be built out. Add the <strong><%= tool.name %></strong> interface here.</p>
    <% } %>
  </div>
</section>

<%- include('partials/footer', { withCalculator: tool.slug === 'standard-calculator', toolScript: widget }) %>
